# ---- CACHI configuration ----
# Copy this file to ".env" and fill in the values before launch.

# Google Analytics 4 measurement ID. Analytics only loads after the visitor
# accepts cookies in the consent banner.
VITE_GA_ID=

# Form delivery service endpoint (Formspree, Basin, Getform, Web3Forms…).
# Until this is set, the contact form validates but asks visitors to email
# you directly — it never fakes a successful submission.
VITE_FORM_ENDPOINT=

# --- Still to replace manually in the code (marked with PLACEHOLDER comments):
# - Official logo file  -> public/images/ + src/components/Logo.jsx
# - Email address       -> hello@cachi.studio (Footer, Contact, CTA)
# - WhatsApp number     -> https://wa.me/000000000000 (Footer, Contact)
# - Social URLs         -> LinkedIn / Instagram / Behance (Footer)
# - Search Console meta -> index.html
